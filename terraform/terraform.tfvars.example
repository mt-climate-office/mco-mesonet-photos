aws_region     = "us-west-2"
aws_profile    = "mco"
project_name   = "mco-mesonet"
s3_bucket_name = "mco-mesonet"
github_repo    = "mt-climate-office/mesonet-photos"
aws_account_id = "YOUR_ACCOUNT_ID"

# REQUIRED here, not optional: since this repo was renamed, GitHub mints an
# immutable subject claim with numeric org/repo IDs instead of the plain
# org/name, so `github_repo` alone will NOT authenticate. Get the live value:
#   gh api repos/mt-climate-office/mesonet-photos/actions/oidc/customization/sub
github_repo_aliases = ["mt-climate-office@ORG_ID/mesonet-photos@REPO_ID"]
